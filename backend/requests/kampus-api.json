      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["health"]
        },
        "body": {
          "mode": "raw",
          "raw": "[\n  \"pm.test(\\\"status ok ve student var\\\", () => { const b = pm.response.json(); pm.expect(b.status).to.eql(\\\"ok\\\"); pm.expect(b.student).to.eql(\\\"2311012023\\\"); });\"\n]",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test(\"Status 200\", () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
